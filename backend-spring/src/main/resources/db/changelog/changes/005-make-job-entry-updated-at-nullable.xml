<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        updated_at stays NULL until an entry is modified for the first time.
    -->
    <changeSet id="005" author="jobapp">
        <dropDefaultValue tableName="job_entry" columnName="updated_at" columnDataType="DATETIME"/>
        <dropNotNullConstraint tableName="job_entry" columnName="updated_at" columnDataType="DATETIME"/>
    </changeSet>

</databaseChangeLog>
