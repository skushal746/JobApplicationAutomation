# Copy to .env and fill in. .env is git-ignored.

# Backend as published by Docker on this machine.
API_URL=http://localhost:8080

# Your login for the Job App (the same one you use in the UI).
APP_EMAIL=you@example.com
APP_PASSWORD=change-me

# How often to look for PENDING job entries.
POLL_INTERVAL_MINUTES=30

# How long to wait for you to enter the emailed code, and to review and submit.
SIGN_IN_TIMEOUT_MINUTES=10
REVIEW_TIMEOUT_MINUTES=30

# Applicant data used to fill forms. Copy profile.example.json to profile.json.
PROFILE_PATH=./profile.json

# Keep false: you need to see the window to enter the code and review the form.
HEADLESS=false
