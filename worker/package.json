{
  "name": "job-application-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runs on the host machine; polls the backend for PENDING job entries and fills applications in a visible Chrome window.",
  "scripts": {
    "start": "tsx --env-file=.env src/index.ts",
    "once": "tsx --env-file=.env src/index.ts --once",
    "try": "tsx src/try.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright-core": "1.47.2"
  },
  "devDependencies": {
    "@types/node": "20.16.5",
    "tsx": "4.20.3",
    "typescript": "5.5.4"
  }
}
